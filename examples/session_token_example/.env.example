# Gateway session token example: configuration.
#
# Nothing here is required. Copy this file to `.env` (same directory) only to change a value:
#
#     cp .env.example .env
#
# `.env` is gitignored. Real environment variables take precedence over `.env`.

# The gateway to run against. The chain id is read from it.
# Mainnet: https://gateway.mainnet.truf.network
PROVIDER_URL=https://gateway.testnet.truf.network

# Optional. Leave unset to use a new random wallet for each run; the example needs no funds.
# Accepts the key with or without a 0x prefix.
# PRIVATE_KEY=
